.hist-app {
  height: 100vh;
  overflow: hidden;
}

.hist-body {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

/* header ------------------------------------------------------------- */

.hist-head {
  flex: none;
  display: flex;
  align-items: center;
  margin: 20rpx 28rpx 14rpx;
  padding: 20rpx 18rpx 20rpx 22rpx;
  border-radius: 26rpx;
  background: linear-gradient(150deg, var(--accent-soft, rgba(34, 211, 238, 0.14)), var(--glass, rgba(255, 255, 255, 0.055)));
  border: 1rpx solid var(--border-strong, rgba(110, 190, 255, 0.34));
  box-shadow: var(--shadow-soft, 0 10rpx 30rpx rgba(0, 0, 0, 0.26));
}

.hist-head-ico {
  flex: none;
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--channel-cron, #fbbf24);
  background: var(--chip-bg, rgba(255, 255, 255, 0.07));
  border: 1rpx solid var(--border, rgba(110, 190, 255, 0.16));
}

.hist-head-copy {
  margin-left: 14rpx;
  padding-right: 10rpx;
}

.hist-head-name {
  font-size: 29rpx;
  font-weight: 700;
  color: var(--text, #e8f2ff);
}

.hist-head-sub {
  margin-top: 3rpx;
  font-size: 20rpx;
  color: var(--mute, #64748b);
}

.hist-refresh {
  flex: none;
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--icon-soft, #a9bdd6);
  background: var(--chip-bg, rgba(255, 255, 255, 0.07));
  border: 1rpx solid var(--border, rgba(110, 190, 255, 0.16));
}

.hist-refresh:active {
  opacity: 0.7;
}

.hist-refresh.spin {
  animation: hist-spin 0.9s linear infinite;
}

@keyframes hist-spin {
  to { transform: rotate(360deg); }
}

/* list --------------------------------------------------------------- */

.hist-scroll {
  flex: 1;
  height: 0;
  box-sizing: border-box;
}

.hist-list {
  padding: 0 28rpx;
  box-sizing: border-box;
}

/* states ------------------------------------------------------------- */

.hist-skeleton {
  padding: 4rpx 28rpx 0;
  box-sizing: border-box;
}

.hist-sk {
  height: 148rpx;
  margin-bottom: 12rpx;
  border-radius: 22rpx;
  background: linear-gradient(90deg, var(--chip-bg, rgba(255, 255, 255, 0.06)) 25%, var(--border, rgba(110, 190, 255, 0.16)) 50%, var(--chip-bg, rgba(255, 255, 255, 0.06)) 75%);
  background-size: 300% 100%;
  animation: hist-shimmer 1.5s linear infinite;
}

@keyframes hist-shimmer {
  from { background-position: 150% 0; }
  to { background-position: -150% 0; }
}

.hist-foot {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 28rpx 30rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: var(--mute, #64748b);
}

.hist-foot-link {
  color: var(--accent, #22d3ee);
}

.hist-mini-spin {
  width: 26rpx;
  height: 26rpx;
  margin-right: 10rpx;
  border: 3rpx solid var(--border, rgba(110, 190, 255, 0.16));
  border-top-color: var(--accent, #22d3ee);
  border-radius: 50%;
  animation: hist-spin 0.8s linear infinite;
}

.hist-empty {
  padding: 110rpx 40rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.hist-empty-orb {
  width: 116rpx;
  height: 116rpx;
  margin-bottom: 24rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent, #22d3ee);
  background: var(--accent-soft, rgba(34, 211, 238, 0.14));
  border: 1rpx solid var(--border-strong, rgba(110, 190, 255, 0.34));
  box-shadow: 0 0 40rpx var(--glow, rgba(34, 211, 238, 0.32));
}

.hist-empty-title {
  font-size: 31rpx;
  font-weight: 700;
  color: var(--text, #e8f2ff);
}

.hist-empty-sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--mute, #64748b);
}

.hist-error-wrap {
  flex: 1;
  padding: 30rpx 28rpx;
  box-sizing: border-box;
}

.hist-error-card {
  margin-top: 60rpx;
  padding: 58rpx 40rpx 48rpx;
  border-radius: 28rpx;
  text-align: center;
  background: linear-gradient(158deg, var(--glass, rgba(255, 255, 255, 0.055)), var(--glass2, rgba(255, 255, 255, 0.015)));
  border: 1rpx solid var(--border, rgba(110, 190, 255, 0.16));
  box-shadow: var(--shadow, 0 24rpx 60rpx rgba(0, 0, 0, 0.42));
}

.hist-error-orb {
  width: 100rpx;
  height: 100rpx;
  margin: 0 auto 22rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--danger, #fb7185);
  background: var(--danger-soft, rgba(251, 113, 133, 0.14));
}

.hist-error-title {
  font-size: 31rpx;
  font-weight: 700;
  color: var(--text, #e8f2ff);
}

.hist-error-sub {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--mute, #64748b);
}

.hist-error-tip {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: var(--mute, #64748b);
}

.hist-error-btn {
  display: inline-flex;
  height: 74rpx;
  margin-top: 26rpx;
  padding: 0 36rpx;
  font-size: 25rpx;
}
